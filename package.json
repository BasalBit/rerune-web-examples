{
  "name": "rerune-web-examples",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev:react": "pnpm --dir examples/react-web-vite dev --host 127.0.0.1 --port 5173",
    "dev:expo": "pnpm --dir examples/react-native-expo start",
    "dev:angular:ngx": "pnpm --dir examples/angular-ngx-translate dev",
    "dev:angular:transloco": "pnpm --dir examples/angular-transloco dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './examples/*' typecheck && tsc -p tests/tsconfig.json",
    "build": "pnpm --filter react-web-vite-example --filter angular-ngx-translate-example --filter angular-transloco-example build",
    "test": "node --test scripts/*.test.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test:browser": "playwright test --project=browser",
    "test:parity": "playwright test --project=parity",
    "export:android": "pnpm --dir examples/react-native-expo exec expo export --platform android --output-dir dist/android"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite": "6.4.2",
    "yaml": "2.8.2"
  }
}
